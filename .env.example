# Earth Information Jukebox — frontend environment (copy to .env.local).
# All of these are read on the SERVER only (route handlers). None is exposed to browser code.
# Never commit real secrets.

# Base URL of the team backend (no trailing slash needed). Leave empty until the backend is running:
# the UI then shows "Backend not configured" and uses local analysis of the NASA media.
EJB_BACKEND_URL=

# Path of the events endpoint that returns the JSON array
# [{ "title", "category", "date", "latitude", "longitude" }]. Confirm with the backend team.
EJB_EVENTS_PATH=/events

# Path of the ocean + temperature series endpoint that returns the JSON array
# [{ "date": "YYYYMMDD", "temperature_celsius", "ocean_intensity" }]. Confirm with the backend team.
EJB_OCEAN_TEMP_PATH=/ocean-temp

# Optional bearer token the server proxy adds when calling the backend. Leave empty if not needed.
EJB_BACKEND_TOKEN=
